# Configuración del asistente de Familias Empresarias.
# Copie este fichero como .env (cp .env.ejemplo .env) y rellene los valores. El fichero .env no se sube a git.
# Las variables definidas en el entorno del sistema mandan sobre las de este fichero.
# Formato: CLAVE=valor (sin espacios alrededor del «=»; las comillas son opcionales).

# ---------- Servidor ----------
# Puerto en el que escucha el servidor (detrás del proxy HTTPS)
PORT=8090
# Dirección pública con HTTPS, sin barra final. Twilio y Meta llaman aquí.
URL_PUBLICA=https://asistente.su-dominio.es
# Carpeta de datos (base SQLite, conocimiento, grabaciones). Por defecto: ./datos
# DATOS_DIR=/srv/asistente/datos

# ---------- Empresa ----------
EMPRESA_NOMBRE=Familias Empresarias
EMPRESA_MARCA=Business Avance
EMPRESA_WEB=https://businessavance.es
# Nombre con el que se presenta la asistente (siempre dice que es una asistente de inteligencia artificial)
ASISTENTE_NOMBRE=Lucía
# Con quién es la sesión estratégica y a quién se transfieren las llamadas
RESPONSABLE_NOMBRE=Valerio García
# Móvil al que se transfieren las llamadas y llegan los avisos por WhatsApp, en formato internacional (+34…)
RESPONSABLE_MOVIL=+346XXXXXXXX
# Correo al que llegan los avisos al equipo
RESPONSABLE_EMAIL=valerio@su-dominio.es
# Responsable del tratamiento de los datos (lo dice la asistente si se lo preguntan)
RESPONSABLE_DATOS=FAMILIAS EMPRESARIAS, S.L.
# PENDIENTE: NIF de Familias Empresarias, S.L. Déjelo vacío hasta conocerlo: sin NIF, la asistente no lo menciona
RESPONSABLE_DATOS_NIF=
RESPONSABLE_DATOS_MARCA=Business Avance International Consulting
# Política de privacidad (apartado «Asistente telefónico y WhatsApp»): la asistente ofrece enviar el enlace por WhatsApp.
# Si se deja vacía y hay ATALAYA_URL, se usa ATALAYA_URL/privacidad.html#asistente; sin ninguna, no se ofrece el enlace.
URL_PRIVACIDAD=
ZONA_HORARIA=Europe/Madrid

# ---------- Claude (Anthropic) ----------
# Clave de la API: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de voz y de texto (no cambiar salvo indicación)
MODELO_VOZ=claude-opus-5-5
MODELO_TEXTO=claude-opus-5-5
# Esfuerzo: low en voz (responde sin pausa), medium en WhatsApp
ESFUERZO_VOZ=low
ESFUERZO_TEXTO=medium
# Si el modelo no está disponible, la API usa uno de respaldo (sí/no)
CLAUDE_FALLBACKS=sí

# ---------- Twilio (llamadas) ----------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Número español comprado en Twilio (con su paquete regulatorio aprobado)
TWILIO_NUMERO=+349XXXXXXXX
# Grabar las llamadas (requiere avisarlo al empezar; ver CUMPLIMIENTO.md)
GRABAR_LLAMADAS=no

# ---------- Deepgram (voz a texto) ----------
DEEPGRAM_API_KEY=
DEEPGRAM_MODELO=nova-3
DEEPGRAM_IDIOMA=es

# ---------- ElevenLabs (texto a voz) ----------
ELEVENLABS_API_KEY=
# ID de la voz: castellano de España, o la voz clonada de Valerio con su consentimiento por escrito
ELEVENLABS_VOZ_ID=
ELEVENLABS_MODELO=eleven_flash_v2_5
# Ajustes finos de la voz (0 a 1; velocidad 0,7 a 1,2)
ELEVENLABS_ESTABILIDAD=0.45
ELEVENLABS_SIMILITUD=0.8
ELEVENLABS_VELOCIDAD=1.0

# ---------- WhatsApp (API Cloud de Meta) ----------
# Token permanente del usuario del sistema de la cuenta de empresa de Meta
WHATSAPP_TOKEN=
# Identificador del número de teléfono (no es el número): WhatsApp → Configuración de la API
WHATSAPP_PHONE_NUMBER_ID=
# Texto que usted inventa y escribe también en Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=
# Clave secreta de la app de Meta (Configuración → Básica), para comprobar la firma de los mensajes
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Plantilla aprobada para escribir fuera de la ventana de 24 horas (nombre exacto en Meta) y su idioma
WHATSAPP_PLANTILLA_SEGUIMIENTO=seguimiento_conversacion
WHATSAPP_PLANTILLA_IDIOMA=es
# Plantilla aprobada para avisar al responsable por WhatsApp (una variable); vacía = solo avisos por correo
WHATSAPP_PLANTILLA_AVISO_EQUIPO=aviso_equipo

# ---------- Avisos al equipo por correo (SMTP) ----------
# Transferencia sin respuesta, urgencia, fallo técnico, sesión por confirmar y bajas llegan a RESPONSABLE_EMAIL
SMTP_HOST=smtp.su-dominio.es
# 587 con STARTTLS o 465 con TLS directo
SMTP_PORT=587
SMTP_USER=asistente@su-dominio.es
SMTP_PASS=
SMTP_FROM=Asistente FE <asistente@su-dominio.es>

# ---------- HubSpot (CRM) ----------
# Token de la app privada (pat-eu1-…)
HUBSPOT_TOKEN=
# ID del propietario al que se asignan contactos, tareas y negocios
HUBSPOT_OWNER_ID=
HUBSPOT_PIPELINE=default
HUBSPOT_ETAPA=appointmentscheduled
# Hub ID de la cuenta, para los enlaces del panel (si no se pone, se lee de la cuenta)
# HUBSPOT_PORTAL_ID=

# ---------- Atalaya 360° ----------
# Las sesiones agendadas aparecen en la mesa de trabajo de la empresa y el panel puede invitar al alta.
# El mismo token en los dos servidores (openssl rand -hex 32). Sin las dos variables no se envía nada.
ATALAYA_URL=https://atalaya.su-dominio.es
INTEGRACION_TOKEN=

# ---------- Google (Calendar y Drive) ----------
# Ruta al JSON de la cuenta de servicio
GOOGLE_CREDENCIALES=/srv/asistente/secretos/google-cuenta-servicio.json
# Calendario donde se reservan las reuniones (su correo o el ID del calendario compartido)
GOOGLE_CALENDAR_ID=valerio@su-dominio.es
# Solo con Google Workspace y delegación de dominio: correo a suplantar
# GOOGLE_SUPLANTAR=valerio@su-dominio.es
# IDs de las carpetas de Drive con los documentos del conocimiento, separados por comas
GOOGLE_DRIVE_CARPETAS=

# ---------- Agenda ----------
# Sesión estratégica: 60 minutos, sin coste, con RESPONSABLE_NOMBRE
REUNION_MINUTOS=60
HORARIO_REUNIONES=L-V 09:30-14:00,16:00-19:00
# Horas mínimas de antelación para reservar
REUNION_ANTELACION_H=24

# ---------- Conocimiento ----------
# Carpeta de la base de conocimiento (por defecto datos/conocimiento)
# CONOCIMIENTO_DIR=
# Páginas web que se descargan en la ingesta, separadas por comas
# CONOCIMIENTO_URLS=https://businessavance.es/,https://valeriogarciamentor.com/
# Máximo de palabras del paquete que va en las instrucciones (más palabras = más coste por turno)
# CONOCIMIENTO_MAX_PALABRAS=60000

# ---------- Prospección (llamadas salientes) ----------
# Interruptor general: no se hace ninguna llamada saliente si no está a «sí»
PROSPECCION_ACTIVA=no
# Horario de llamadas. Siempre se limita a días laborables de 9:00 a 21:00 aunque aquí ponga otra cosa.
# Formato: días (L M X J V) y tramos; varios grupos separados por «;». Ej.: L-J 10:00-14:00,16:30-20:00; V 10:00-14:00
HORARIO_LLAMADAS=L-V 10:00-14:00,16:30-20:00
# Máximo de intentos por contacto y campaña
PROSPECCION_MAX_INTENTOS=3
# Horas mínimas entre dos intentos al mismo contacto
PROSPECCION_SEPARACION_H=48
# Días que vale la lista Robinson importada (fecha de la lista): con una más antigua no se activa ni se llama
ROBINSON_MAX_DIAS=30
# Llamadas salientes a la vez
PROSPECCION_SIMULTANEAS=2
# Festivos (AAAA-MM-DD para uno concreto, MM-DD para todos los años), separados por comas.
# Incluya los nacionales, los de su comunidad autónoma y los locales.
FESTIVOS=01-01,01-06,05-01,08-15,10-12,11-01,12-06,12-08,12-25

# ---------- Panel ----------
PANEL_USUARIO=admin
# Sin clave el panel está desactivado. Use una contraseña larga (16 caracteres o más).
PANEL_CLAVE=
# Clave para firmar la sesión del panel (texto aleatorio largo). Si falta, las sesiones caducan al reiniciar.
# Genérela con: openssl rand -hex 32
PANEL_SECRETO=

# ---------- Conservación de datos (CUMPLIMIENTO.md §6.3) ----------
# Purga diaria de lo que supera los plazos (no=desactivada)
PURGA_ACTIVA=sí
CONSERVAR_MENSAJES_MESES=12
CONSERVAR_MENSAJES_CLIENTES_MESES=72
CONSERVAR_GRABACIONES_MESES=3
CONSERVAR_EVENTOS_MESES=12
CONSERVAR_PRUEBA_BASE_LEGAL_MESES=36
