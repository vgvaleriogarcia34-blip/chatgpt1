# --- Server ---
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=cambia-esto-por-algo-aleatorio-largo

# --- Claude (Anthropic) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# --- Meta / Instagram Graph API ---
# https://developers.facebook.com/  -> App tipo "Business"
# La cuenta de Instagram tiene que ser Business o Creator y estar vinculada a una Pagina de Facebook.
# Scopes necesarios: instagram_basic, instagram_content_publish, pages_show_list,
#                    pages_read_engagement, business_management
META_APP_ID=
META_APP_SECRET=
# Se rellena automaticamente despues del OAuth (ver /auth/instagram)
META_LONG_LIVED_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- LinkedIn ---
# https://www.linkedin.com/developers/
# Producto: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# Scopes: openid, profile, email, w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Se rellenan automaticamente despues del OAuth (ver /auth/linkedin)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MEMBER_URN=
