# Atalaya 360° · variables del servidor (instalar.sh crea atalaya.env a partir de este fichero)
NODE_ENV=production
APP_URL=https://app.su-dominio.es
COOKIE_SECURE=1
TRUST_PROXY=1
ZONA_HORARIA=Europe/Madrid
# Primera contraseña de la administración (se cambia después desde admin.html)
ADMIN_PASSWORD=
# Secreto para enlaces, segundo factor y códigos de recuperación. No lo cambie una vez en marcha.
ATALAYA_SECRETO=
# IA (asistente, lectura de documentos, agente de mercado y revisión del sistema)
ANTHROPIC_API_KEY=
# Correo de salida (invitaciones, contraseñas olvidadas, avisos al equipo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AVISOS_EMAIL=
# Cobro con Stripe (opcional; sin él los pagos se registran a mano)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# HubSpot (opcional)
HUBSPOT_TOKEN=
HUBSPOT_OWNER_ID=
# Integración con el asistente telefónico: el mismo valor aquí y en asistente.env
INTEGRACION_TOKEN=
