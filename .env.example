# ===== Configuración del blog automático (copia estos valores en los Secrets de Replit) =====

# JSON completo de la cuenta de servicio de Google (una sola línea).
# Lo obtienes en Google Cloud → IAM → Cuentas de servicio → Claves → Crear clave (JSON).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"blog-bot@tu-proyecto.iam.gserviceaccount.com","client_id":"..."}

# ID de la carpeta de Drive "Articulos blog generados".
# (Por defecto ya apunta a la carpeta actual de Círculo de Claridad.)
DRIVE_FOLDER_ID=1f-po96lSMY3uaNYYEd-d8eP8gWyqxWyk

# Cada cuántos minutos se revisa Drive en busca de artículos nuevos.
SYNC_INTERVAL_MINUTES=15

# (Opcional) Token para proteger el endpoint manual POST /blog/sync?token=...
SYNC_TOKEN=

# Puerto (Replit lo gestiona solo; en local usa 3000).
PORT=3000
